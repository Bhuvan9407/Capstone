          "description": "Replace-upsert per student and mentor pair. Every shared id is ownership-checked."
        } },
        { "name": "Revoke grant (student)", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/grants/:id", "host": ["{{baseUrl}}"], "path": ["grants", ":id"] } } },
