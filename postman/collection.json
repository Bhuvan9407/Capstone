    {
      "name": "Portfolio",
      "item": [
        { "name": "My portfolio (auto-creates default)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/portfolio", "host": ["{{baseUrl}}"], "path": ["portfolio"] } } },
        { "name": "Update fields / publish / unpublish", "request": {
