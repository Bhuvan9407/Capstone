        { "name": "Revoke invitation (student)", "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": { "raw": "{{baseUrl}}/mentor-invitations/:id/revoke", "host": ["{{baseUrl}}"], "path": ["mentor-invitations", ":id", "revoke"] },
