# ---- Application environment ----
NODE_ENV=development
BACKEND_PORT=5000
# Explicit allowlist of frontend origins (comma separated)
FRONTEND_ORIGIN=http://localhost:5173
# Backend public base URL (used to build links in emails)
BACKEND_PUBLIC_URL=http://localhost:5000

# ---- MongoDB Atlas ----
# Replace with your Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/career-coach?retryWrites=true&w=majority
# Separate DB (or URI) used by automated tests only
MONGO_URI_TEST=

# ---- Sessions / security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=168

# ---- Emails (development adapter) ----
EMAIL_ADAPTER=dev
# dev -> inboxes are stored in the database and covered by GET /api/dev-inbox
DEV_EMAIL_MAX_INBOX=50

# ---- Uploads ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_MIME=application/pdf,text/plain

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000

# ---- AI retrieval ----
# top-k for vector search and chat context chunks
RETRIEVAL_TOP_K=6
CHAT_MAX_CHUNKS=30
# Toggle the deterministic keyword fallback when Atlas Vector Search is unavailable.
# The fallback is always clearly labelled; it never claims real vector retrieval.
RETRIEVAL_FALLBACK_KEYWORD=true

# ---- Agent limits ----
AGENT_MAX_STEPS=8
AGENT_TIME_BUDGET_MS=120000

# ---- Production (HTTPS cookie) ----
# Set COOKIE_SECURE=true when serving the app over HTTPS
COOKIE_SECURE=false
